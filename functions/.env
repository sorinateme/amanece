# Modelo de Claude (precio por millón de tokens entrada/salida):
#   claude-haiku-4-5   -> $1 / $5   (el más barato)
#   claude-sonnet-5-5  -> $2 / $10
#   claude-opus-5-5    -> $4 / $20  (el más capaz)
MODEL=claude-opus-5-5

# Dominios autorizados a usar el chat, separados por coma.
# CAMBIA TU-DOMINIO por el dominio real de la página en Hostinger.
# capacitor://localhost y https://localhost son la app móvil (iOS/Android).
ALLOWED_ORIGINS=https://TU-DOMINIO.org,https://www.TU-DOMINIO.org,capacitor://localhost,https://localhost,http://localhost:8080
